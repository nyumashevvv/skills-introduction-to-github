[node name="Outskirts" type="Node3D"]
script = ExtResource("1_level")
chapter_number = 1
chapter_title = "Окраина"
intro_text = "Девять дней назад мёртвые поднялись. Город пал за двое суток.\nТы прятался в подвале, пока не кончилась еда. Сегодня ночью старая рация наконец ожила — кто-то ещё жив. И у них есть вертолёт."
start_objective = "Доберись до полицейского участка в конце улицы"
start_event = NodePath("Story/Intro")
default_weapons = PackedStringArray("knife", "pistol")
default_ammo = {"pistol": 24}

