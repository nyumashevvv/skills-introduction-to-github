script = ExtResource("1_level")
chapter_number = 5
chapter_title = "Стадион"
intro_text = "Лестница метро выводит прямо к южным воротам стадиона.\nНад трибунами горят прожекторы. Где-то там, в темноте, гудит вертолёт."
