[node name="Subway" type="Node3D"]
script = ExtResource("1_level")
chapter_number = 4
chapter_title = "Метро"
intro_text = "Станция «Больничная». Эскалаторы стоят, турникеты погнуты, на стенах — выцветшие объявления об эвакуации.\nДо «Динамо» два перегона по тоннелю. Поезда давно не ходят. Наверное."
start_objective = "Пройди по тоннелю до станции «Динамо»"
start_event = NodePath("Story/Intro")
default_weapons = PackedStringArray("knife", "pistol", "shotgun", "rifle", "bazooka")
default_ammo = {"pistol": 24, "shells": 16, "rifle": 90, "rocket": 2}

