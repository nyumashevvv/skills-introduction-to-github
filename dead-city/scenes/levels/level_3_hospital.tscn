[node name="Hospital" type="Node3D"]
script = ExtResource("1_level")
chapter_number = 3
chapter_title = "Больница"
intro_text = "Машина заглохла у ворот городской больницы. Мост к стадиону забит брошенными машинами — остаётся метро, а вход в него сразу за больницей.\nВнутри темно и тихо. Слишком тихо для места, где лечили сотни людей."
start_objective = "Запусти генератор в техническом крыле, чтобы открыть пожарный выход"
start_event = NodePath("Story/Intro")
default_weapons = PackedStringArray("knife", "pistol", "rifle", "bazooka")
default_ammo = {"pistol": 24, "rifle": 90, "rocket": 2}

