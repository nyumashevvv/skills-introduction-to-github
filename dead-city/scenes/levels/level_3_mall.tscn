[node name="Mall" type="Node3D"]
script = ExtResource("1_level")
chapter_number = 3
chapter_title = "Торговый центр"
intro_text = "Машина заглохла через два квартала: пробит бак. Улицу к больнице перегородила баррикада из автобусов.\nКороткий путь — насквозь через торговый центр «Галактика». С крыши-парковки пандус спускается прямо к больничным воротам."
start_objective = "Проберись в торговый центр «Галактика»"
start_event = NodePath("Story/Intro")
default_weapons = PackedStringArray("knife", "pistol", "rifle", "bazooka")
default_ammo = {"pistol": 24, "rifle": 90, "rocket": 2}

