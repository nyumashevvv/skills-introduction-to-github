collision_mask = 2
monitorable = false
script = ExtResource("233_story_trigger")
event = NodePath("../Inside")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Story/EntranceTrigger"]
shape = SubResource("BoxShape3D_84")

[node name="Inside" type="Node" parent="Story"]
script = ExtResource("232_story_event")
objective = "Запусти генератор: 1-й этаж, восточное крыло, в конце"
speaker = "Диспетчер"
message = "Темно… эскалаторы стоят, решётка на третий этаж без питания. Генераторная на первом этаже, в восточном крыле, в самом конце, за игрушками. Запусти генератор."
message_duration = 9.0

[node name="PowerOn" type="Node" parent="Story"]
script = ExtResource("232_story_event")
objective = "Поднимись на третий этаж к кинотеатру"
speaker = "Диспетчер"
