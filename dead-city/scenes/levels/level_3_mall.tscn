[node name="Intro" type="Node" parent="Story"]
script = ExtResource("232_story_event")
speaker = "Диспетчер"
message = "Машина встала? Через улицу не пройти — там баррикада. Иди через «Галактику»: с крыши парковки пандус спускается прямо к больнице."
message_duration = 9.0

[node name="EntranceTrigger" type="Area3D" parent="Story"]
