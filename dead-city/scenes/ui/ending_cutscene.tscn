[node name="EndingCutscene" type="Control"]
script = ExtResource("2_cutscene")
shots = PackedStringArray("Liftoff", "Rise", "City", "Dawn")
speakers = PackedStringArray("Пилот", "", "Диспетчер", "")
lines = PackedStringArray("Держись крепче! Взлетаем!", "Стадион уходил вниз. Мёртвые тянули к нам руки, будто ещё могли достать.", "Борт-двенадцать, вижу вас. Коридор чистый, курс на базу. Добро пожаловать в живые.", "Девять дней я ждал рассвета. Город остался позади. Где-то там ещё есть люди — и теперь я снова один из них.")
finish_call = &"show_ending"
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

