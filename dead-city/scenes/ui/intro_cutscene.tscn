[node name="IntroCutscene" type="Control"]
script = ExtResource("2_cutscene")
shots = PackedStringArray("News", "City", "Street", "Basement", "Radio", "Door")
speakers = PackedStringArray("Новости", "", "", "", "Диспетчер", "")
lines = PackedStringArray("Экстренный выпуск. Власти просят жителей не покидать дома и не открывать двери незнакомым. Число заболевших растёт с каждым часом.", "Девять дней назад это передавали по всем каналам. Говорили — новый грипп. Через сутки больницы были переполнены.", "Через двое суток город пал. Мёртвые поднимались и шли за живыми. Армия ушла первой.", "Я спрятался в подвале своего дома. Девять дней тишины, консервы и старая рация. Вчера кончилась еда.", "…если кто-то слышит — эвакуация со стадиона «Динамо» на рассвете. Повторяю: стадион, на рассвете.", "Стадион на другом конце города. Но другого шанса не будет. Пора выходить.")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

